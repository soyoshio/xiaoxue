[Unit]
Description=Openbox window manager for virtual display :99
Requires=xvfb.service
After=xvfb.service
PartOf=xvfb.service

[Service]
Type=simple
User=YOUR_USERNAME
Environment=DISPLAY=:99
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
