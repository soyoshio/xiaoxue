# 复制为 .env 填写。shell 已导出的变量优先。
# 所有配置必须显式写出,代码不提供默认值。

# ---------- 文件位置(目录/文件不存在会自动创建) ----------
AGENT_RUN_DIR=run                                  # 运行时目录(相对项目目录;系统内部使用)
AGENT_PERSONA=persona.md                           # 人设(相对项目目录;仅用户可改)

AGENT_HOME=/a-home                          # 她的家(独立目录,可在任意位置);bash 的 cwd
AGENT_MEMORY=/a-home/memory/memory.md       # 主记忆文件(占位符 ${MEMORY})
AGENT_MEMORY_DIR=/a-home/memory             # 记忆细节目录(占位符 ${MEMORY_DIR})
AGENT_FRIEND=/a-home/friend.md              # 朋友记忆文件(占位符 ${FRIEND})
AGENT_SUMMARY_DIR=/a-home/summary           # 总结归档目录(占位符 ${SUMMARY})

# ---------- LLM(必须视觉模型) ----------
AGENT_MODEL_PROVIDER=deepseek
AGENT_MODEL_ID=deepseek-flash
AGENT_MODEL_CONTEXT_WINDOW=65536
AGENT_MODEL_MAX_TOKENS=8192
# 可选:设置后走自定义 OpenAI 兼容地址;否则查 pi-ai 注册表,deepseek 使用官方地址
# AGENT_MODEL_BASE_URL=https://api.deepseek.com

# ---------- API key(二选一) ----------
LLM_API_KEY=
# DEEPSEEK_API_KEY=sk-xxx

# ---------- 虚拟桌面 ----------
DISPLAY=:99

# ---------- 上下文与压缩 ----------
AGENT_RECENT_TURNS=20                                # 每次醒来注入的最近对话轮数
AGENT_COMPACT_MIN_BATCH=50                           # 历史窗口外至少积累多少轮才归档压缩

# ---------- 自醒与循环 ----------
AGENT_HEARTBEAT_MIN=1                                # 闲置多少分钟后自醒一次
AGENT_POLL_MS=1000                                   # 主循环检查 inbox/wake/自醒条件的间隔
AGENT_RETRY_MS=5000                                  # 醒来失败后的重试间隔

# ---------- 工具 ----------
AGENT_BASH_DEFAULT_TIMEOUT_MS=30000                   # bash 默认超时
AGENT_BASH_MAX_TIMEOUT_MS=120000                      # bash timeout_ms 参数上限
AGENT_BASH_MAX_OUTPUT=16000                           # bash stdout/stderr 各自注入的字符上限
AGENT_IMAGE_MAX_MB=8                                  # view_image 单张图片大小上限
